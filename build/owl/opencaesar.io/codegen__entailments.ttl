@prefix codegen: <http://opencaesar.io/codegen#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix oml:   <http://opencaesar.io/oml#> .

oml:UnreifiedRelation
        rdfs:subClassOf  owl:Thing , oml:UnreifiedRelation .

oml:Scalar  rdfs:subClassOf  owl:Thing , oml:Scalar .

codegen:context  rdfs:subPropertyOf  owl:topDataProperty , codegen:context .

oml:ReverseRelation  rdfs:subClassOf  owl:Thing , oml:ReverseRelation .

codegen:construct  rdfs:subPropertyOf  owl:topDataProperty , codegen:construct .

oml:unit  rdfs:subPropertyOf  owl:topObjectProperty , oml:unit .

oml:Unit  rdfs:subClassOf  owl:Thing , oml:Unit .

oml:Concept  rdfs:subClassOf  owl:Thing , oml:Concept .

codegen:key  rdfs:subPropertyOf  owl:topDataProperty , codegen:key .

oml:Aspect  rdfs:subClassOf  owl:Thing , oml:Aspect .

oml:DescriptionBundle
        rdfs:subClassOf  owl:Thing , oml:DescriptionBundle .

oml:ConceptInstance  rdfs:subClassOf  owl:Thing , oml:ConceptInstance .

oml:ForwardRelation  rdfs:subClassOf  owl:Thing , oml:ForwardRelation .

codegen:value  rdfs:subPropertyOf  owl:topDataProperty , codegen:value .

oml:symbol  rdfs:subPropertyOf  owl:topDataProperty , oml:symbol .

codegen:root  rdfs:subPropertyOf  owl:topObjectProperty , codegen:root .

oml:relationBase  rdfs:subPropertyOf  owl:topObjectProperty , oml:relationBase .

oml:value  rdfs:subPropertyOf  owl:topDataProperty , oml:value .

owl:Nothing  a           owl:Class ;
        rdfs:subClassOf  oml:ConceptInstance , oml:Unit , oml:QuantityLiteral , oml:Rule , codegen:File , oml:DescriptionBundle , oml:Description , owl:Thing , oml:VocabularyBundle , oml:Concept , codegen:Spec , oml:BuiltIn , oml:UnreifiedRelation , oml:Vocabulary , oml:RelationInstance , codegen:Template , oml:Quantity , codegen:Config , codegen:Binding , oml:RelationEntity , oml:Aspect , oml:Scalar , oml:ForwardRelation , owl:Nothing , oml:ReverseRelation .

owl:bottomDataProperty
        a                   owl:DatatypeProperty ;
        rdfs:subPropertyOf  owl:topDataProperty , owl:bottomDataProperty , oml:symbol , codegen:construct , oml:value , codegen:key , codegen:context , codegen:value , oml:multiplier , codegen:path , oml:dimension , codegen:body , codegen:parameter .

oml:measures  rdfs:subPropertyOf  owl:topObjectProperty , oml:measures .

oml:multiplier  rdfs:subPropertyOf  owl:topDataProperty , oml:multiplier .

codegen:binding  rdfs:subPropertyOf  owl:topObjectProperty , codegen:binding .

codegen:Config  rdfs:subClassOf  owl:Thing , codegen:Config .

oml:relationEntity  rdfs:subPropertyOf  owl:topObjectProperty , oml:relationEntity .

codegen:Template  rdfs:subClassOf  owl:Thing , codegen:Template .

codegen:template  rdfs:subPropertyOf  owl:topObjectProperty , codegen:template .

oml:Rule  rdfs:subClassOf  owl:Thing , oml:Rule .

owl:Thing  a             owl:Class ;
        rdfs:subClassOf  owl:Thing .

<http://opencaesar.io/codegen__entailments>
        a            owl:Ontology ;
        owl:imports  <http://opencaesar.io/codegen> .

oml:Vocabulary  rdfs:subClassOf  owl:Thing , oml:Vocabulary .

oml:BuiltIn  rdfs:subClassOf  owl:Thing , oml:BuiltIn .

oml:RelationInstance  rdfs:subClassOf  owl:Thing , oml:RelationInstance .

oml:VocabularyBundle  rdfs:subClassOf  owl:Thing , oml:VocabularyBundle .

owl:topObjectProperty
        a                   owl:SymmetricProperty , owl:TransitiveProperty , owl:ObjectProperty ;
        rdfs:subPropertyOf  owl:topObjectProperty ;
        owl:inverseOf       owl:topObjectProperty .

owl:topDataProperty  a      owl:DatatypeProperty ;
        rdfs:subPropertyOf  owl:topDataProperty .

oml:QuantityLiteral  rdfs:subClassOf  owl:Thing , oml:QuantityLiteral .

codegen:spec  rdfs:subPropertyOf  owl:topObjectProperty , codegen:spec .

codegen:Spec  rdfs:subClassOf  owl:Thing , codegen:Spec .

owl:bottomObjectProperty
        a                   owl:SymmetricProperty , owl:ObjectProperty ;
        rdfs:subPropertyOf  codegen:spec , oml:relationEntity , oml:hasTarget , codegen:root , owl:topObjectProperty , codegen:template , codegen:binding , oml:hasSource , oml:relationBase , oml:unit , owl:bottomObjectProperty , oml:measures ;
        owl:inverseOf       owl:bottomObjectProperty .

oml:hasSource  rdfs:subPropertyOf  owl:topObjectProperty , oml:hasSource .

oml:Description  rdfs:subClassOf  owl:Thing , oml:Description .

oml:hasTarget  rdfs:subPropertyOf  owl:topObjectProperty , oml:hasTarget .

oml:RelationEntity  rdfs:subClassOf  owl:Thing , oml:RelationEntity .

codegen:Binding  rdfs:subClassOf  owl:Thing , codegen:Binding .

codegen:parameter  rdfs:subPropertyOf  owl:topDataProperty , codegen:parameter .

codegen:File  rdfs:subClassOf  owl:Thing , codegen:File .

codegen:path  rdfs:subPropertyOf  owl:topDataProperty , codegen:path .

codegen:body  rdfs:subPropertyOf  owl:topDataProperty , codegen:body .

oml:Quantity  rdfs:subClassOf  owl:Thing , oml:Quantity .

oml:dimension  rdfs:subPropertyOf  owl:topDataProperty , oml:dimension .
