@prefix oml: <http://opencaesar.io/oml#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix amplifier: <https://leaphar06.github.io/amplifier-cross-reference-ontology/vocabulary#>.
@prefix amplifier-desc: <https://leaphar06.github.io/amplifier-cross-reference-ontology/description#>.

amplifier-desc:AD8000 oml:type oml:ConceptInstance;
    a amplifier:CompetitorAmplifier;
    amplifier:belongsToVendor amplifier-desc:ADI;
    amplifier:partNumber "AD8000".
amplifier-desc:AD8001 oml:type oml:ConceptInstance;
    a amplifier:CompetitorAmplifier;
    amplifier:belongsToVendor amplifier-desc:ADI;
    amplifier:partNumber "AD8001".
amplifier-desc:ADI oml:type oml:ConceptInstance;
    a amplifier:CompetitorVendor;
    amplifier:vendorName "Analog Devices".
amplifier-desc:biasCrit oml:type oml:ConceptInstance;
    a amplifier:InputBiasCurrentCriterion.
amplifier-desc:gap1 oml:type oml:ConceptInstance;
    a amplifier:CoverageGap;
    amplifier:derivedFrom amplifier-desc:pm3;
    amplifier:gapCount 1.
amplifier-desc:gbwCrit oml:type oml:ConceptInstance;
    a amplifier:GBWCriterion.
amplifier-desc:HSAMPS oml:type oml:ConceptInstance;
    a amplifier:ProductLine;
    amplifier:productLineName "HSAMPS".
amplifier-desc:LinearTech oml:type oml:ConceptInstance;
    a amplifier:CompetitorVendor;
    amplifier:vendorName "Linear Technology".
amplifier-desc:LMH6624 oml:type oml:ConceptInstance;
    a amplifier:HighSpeedAmplifier;
    amplifier:partNumber "LMH6624".
amplifier-desc:LT1220 oml:type oml:ConceptInstance;
    a amplifier:CompetitorAmplifier;
    amplifier:belongsToVendor amplifier-desc:LinearTech;
    amplifier:partNumber "LT1220".
amplifier-desc:LT1360 oml:type oml:ConceptInstance;
    a amplifier:CompetitorAmplifier;
    amplifier:belongsToVendor amplifier-desc:LinearTech;
    amplifier:partNumber "LT1360".
amplifier-desc:noiseCrit oml:type oml:ConceptInstance;
    a amplifier:NoiseDensityCriterion.
amplifier-desc:OPA842 oml:type oml:ConceptInstance;
    a amplifier:HighSpeedAmplifier;
    amplifier:belongsToLine amplifier-desc:HSAMPS;
    amplifier:partNumber "OPA842".
amplifier-desc:OPA843 oml:type oml:ConceptInstance;
    a amplifier:HighSpeedAmplifier;
    amplifier:belongsToLine amplifier-desc:HSAMPS;
    amplifier:partNumber "OPA843".
amplifier-desc:OPA847 oml:type oml:ConceptInstance;
    a amplifier:HighSpeedAmplifier;
    amplifier:belongsToLine amplifier-desc:HSAMPS;
    amplifier:partNumber "OPA847".
amplifier-desc:packageCrit oml:type oml:ConceptInstance;
    a amplifier:PackageCriterion.
amplifier-desc:pm1 oml:type oml:ConceptInstance;
    a amplifier:ParameterMatch;
    amplifier:comparesTo amplifier-desc:LT1360;
    amplifier:evaluatesCriterion amplifier-desc:gbwCrit;
    amplifier:governedBy amplifier-desc:policy1;
    amplifier:matches true.
amplifier-desc:pm2 oml:type oml:ConceptInstance;
    a amplifier:ParameterMatch;
    amplifier:comparesTo amplifier-desc:LT1360;
    amplifier:evaluatesCriterion amplifier-desc:supplyCrit;
    amplifier:governedBy amplifier-desc:policy1;
    amplifier:matches true.
amplifier-desc:pm3 oml:type oml:ConceptInstance;
    a amplifier:ParameterMatch;
    amplifier:comparesTo amplifier-desc:LT1360;
    amplifier:evaluatesCriterion amplifier-desc:packageCrit;
    amplifier:governedBy amplifier-desc:policy1;
    amplifier:matches false.
amplifier-desc:pm4 oml:type oml:ConceptInstance;
    a amplifier:ParameterMatch;
    amplifier:comparesTo amplifier-desc:AD8000;
    amplifier:evaluatesCriterion amplifier-desc:slewCrit;
    amplifier:matches true.
amplifier-desc:pm5 oml:type oml:ConceptInstance;
    a amplifier:ParameterMatch;
    amplifier:comparesTo amplifier-desc:AD8000;
    amplifier:evaluatesCriterion amplifier-desc:biasCrit;
    amplifier:matches false.
amplifier-desc:policy1 oml:type oml:ConceptInstance;
    a amplifier:ThresholdPolicy;
    amplifier:policyName "HSAMPS default 5% tolerance".
amplifier-desc:slewCrit oml:type oml:ConceptInstance;
    a amplifier:SlewRateCriterion.
amplifier-desc:supplyCrit oml:type oml:ConceptInstance;
    a amplifier:SupplyVoltageCriterion.
amplifier-desc:tempCrit oml:type oml:ConceptInstance;
    a amplifier:TempGradeCriterion.
<https://leaphar06.github.io/amplifier-cross-reference-ontology/description> oml:namespace <https://leaphar06.github.io/amplifier-cross-reference-ontology/description#>;
    oml:prefix "amplifier-desc";
    oml:type oml:Description;
    a owl:Ontology;
    owl:imports <http://opencaesar.io/oml>, <https://leaphar06.github.io/amplifier-cross-reference-ontology/vocabulary>.
amplifier-desc:LMH6624 amplifier:belongsToLine amplifier-desc:HSAMPS_OPAMP.
amplifier-desc:HSAMPS_OPAMP oml:type oml:ConceptInstance;
    a amplifier:ProductLine;
    amplifier:productLineName "HSAMPS-OPAMP".
amplifier-desc:HSAMPS amplifier:hasSubLine amplifier-desc:HSAMPS_OPAMP.
amplifier-desc:OPA842 amplifier:hasParameterMatch amplifier-desc:pm4, amplifier-desc:pm5.
amplifier-desc:OPA847 amplifier:hasParameterMatch amplifier-desc:pm1, amplifier-desc:pm2, amplifier-desc:pm3.
amplifier-desc:LMH6624 amplifier:hasParameterMatch amplifier-desc:pm13, amplifier-desc:pm14, amplifier-desc:pm15, amplifier-desc:pm16, amplifier-desc:pm17, amplifier-desc:pm18, amplifier-desc:pm19.
amplifier-desc:OPA843 amplifier:hasParameterMatch amplifier-desc:pm10, amplifier-desc:pm11, amplifier-desc:pm12, amplifier-desc:pm6, amplifier-desc:pm7, amplifier-desc:pm8, amplifier-desc:pm9.
amplifier-desc:pm10 oml:type oml:ConceptInstance;
    a amplifier:ParameterMatch;
    amplifier:comparesTo amplifier-desc:LT1220;
    amplifier:evaluatesCriterion amplifier-desc:biasCrit;
    amplifier:matches true.
amplifier-desc:pm11 oml:type oml:ConceptInstance;
    a amplifier:ParameterMatch;
    amplifier:comparesTo amplifier-desc:LT1220;
    amplifier:evaluatesCriterion amplifier-desc:noiseCrit;
    amplifier:matches false.
amplifier-desc:pm12 oml:type oml:ConceptInstance;
    a amplifier:ParameterMatch;
    amplifier:comparesTo amplifier-desc:LT1220;
    amplifier:evaluatesCriterion amplifier-desc:tempCrit;
    amplifier:matches true.
