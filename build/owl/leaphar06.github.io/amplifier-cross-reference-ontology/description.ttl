    amplifier:evaluatesCriterion amplifier-desc:noiseCrit;
    amplifier:matches true.
amplifier-desc:pm19 oml:type oml:ConceptInstance;
    a amplifier:ParameterMatch;
    amplifier:comparesTo amplifier-desc:AD8001;
    amplifier:evaluatesCriterion amplifier-desc:tempCrit;
    amplifier:matches true.
amplifier-desc:pm6 oml:type oml:ConceptInstance;
    a amplifier:ParameterMatch;
    amplifier:comparesTo amplifier-desc:LT1220;
    amplifier:evaluatesCriterion amplifier-desc:gbwCrit;
    amplifier:matches true.
amplifier-desc:pm7 oml:type oml:ConceptInstance;
    a amplifier:ParameterMatch;
    amplifier:comparesTo amplifier-desc:LT1220;
    amplifier:evaluatesCriterion amplifier-desc:supplyCrit;
    amplifier:matches true.
amplifier-desc:pm8 oml:type oml:ConceptInstance;
